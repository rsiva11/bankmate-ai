# Copy to .env and edit. Never commit .env.

# --- Local LLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_TIMEOUT_SECONDS=90
# 1 = deterministic keyword classifier + extractive answers (no LLM needed)
BANKMATE_MOCK_LLM=0

# --- Simulated banking API ---
BANK_API_BASE_URL=http://localhost:8000
BANK_API_TIMEOUT_SECONDS=10

# --- RAG ---
# "sentence-transformers" (real, default) or "hash" (tiny deterministic, for tests/offline demos)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_DIR=chroma_db
CHROMA_COLLECTION=sbi_public_docs
RAG_TOP_K=4
# Max cosine distance accepted as "relevant" (lower = stricter). Tune with: python -m rag.retriever "question"
RAG_MAX_DISTANCE=0.70
CHUNK_SIZE_CHARS=900
CHUNK_OVERLAP_CHARS=150

# --- Fraud / risk rule thresholds (demo values) ---
RISK_LARGE_AMOUNT=50000
RISK_BURST_COUNT=3
RISK_BURST_WINDOW_MINUTES=15
RISK_REPEAT_COUNT=3
RISK_DEMO_INDICATORS=foreign_location,new_beneficiary

# --- Loan demo rule (NOT official SBI criteria) ---
LOAN_MAX_DTI=0.50
LOAN_MIN_RESIDUAL_INCOME=10000
LOAN_ANNUAL_INTEREST_PCT=10.5
LOAN_DEFAULT_TENURE_MONTHS=36
